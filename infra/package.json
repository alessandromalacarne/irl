{
  "name": "irl",
  "version": "0.1.0",
  "bin": {
    "irl": "bin/irl.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run --no-color",
    "cdk": "cdk",
    "db:local": "ts-node --prefer-ts-exts bin/create-table.ts",
    "deploy": "npx aws-cdk@latest deploy --outputs-file cdk-outputs.json"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "22.7.9",
    "@vitest/coverage-v8": "^4.1.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "aws-cdk-lib": "^2.236.0",
    "constructs": "^10.4.5"
  }
}
